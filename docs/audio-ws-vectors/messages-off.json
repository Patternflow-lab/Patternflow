{
  "contract": "docs/audio-ws-spec.md#messages",
  "says": "Release all four.",
  "features": ["audio"],
  "steps": [
    { "send": { "ws": "a=0.25,0.5,0.75,1" } },
    { "send": { "wait": 20 }, "expect": { "status": { "laneActive": [true, true, true, true] } } },
    { "send": { "ws": "off" } },
    { "send": { "wait": 20 }, "expect": { "status": { "laneActive": [false, false, false, false] } } }
  ]
}
