{
  "contract": "docs/audio-ws-spec.md#semantics--what-a-lane-is",
  "says": "Priority per knob, highest first (see `abi/pf_params.h`):",
  "features": ["audio"],
  "steps": [
    { "send": { "ws": "a=0.5,0.5,-,-" } },
    { "send": { "wait": 20 }, "expect": { "status": { "laneActive": [true, true, false, false] } } },
    { "send": { "http": "POST /api/params?p1=700" } },
    { "send": { "ws": "a=0.5,0.5,-,-" } },
    { "send": { "wait": 20 }, "expect": { "status": { "params": [700, "<integer>", "<integer>", "<integer>"], "paramActive": [true, false, false, false], "laneActive": [false, true, false, false] } } }
  ]
}
