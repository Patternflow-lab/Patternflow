{
  "contract": "docs/audio-ws-spec.md#messages",
  "says": "Release knob `N` back to encoder control.",
  "features": ["audio"],
  "steps": [
    { "send": { "ws": "a=0.25,0.5,0.75,1" } },
    { "send": { "wait": 20 }, "expect": { "status": { "laneActive": [true, true, true, true] } } },
    { "send": { "ws": "off=2" } },
    { "send": { "wait": 20 }, "expect": { "status": { "laneActive": [true, true, false, true] } } },
    { "send": { "ws": "off=0" } },
    { "send": { "wait": 20 }, "expect": { "status": { "laneActive": [false, true, false, true] } } }
  ]
}
