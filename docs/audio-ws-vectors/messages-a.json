{
  "contract": "docs/audio-ws-spec.md#messages",
  "says": "A literal `-` in a slot leaves that lane untouched: `a=0.8,-,-,0.2`.",
  "features": ["audio"],
  "steps": [
    { "send": { "ws": "a=0.25,0.5,0.75,1" } },
    { "send": { "wait": 20 }, "expect": { "status": { "lanes": [0.25, 0.5, 0.75, 1], "laneActive": [true, true, true, true] } } },
    { "send": { "wait": 200 } },
    { "send": { "ws": "a=0.8,-,-,0.2" } },
    { "send": { "wait": 20 }, "expect": { "status": { "lanes": [0.8, 0.5, 0.75, 0.2], "laneActive": [true, true, true, true] } } },
    { "send": { "wait": 400 }, "expect": { "status": { "laneActive": [true, false, false, true] } } },
    { "send": { "ws": "a=-0.5,0.25,-,-" } },
    { "send": { "wait": 20 }, "expect": { "status": { "lanes": ["<number>", 0.25, 0.75, 0.2] } } }
  ]
}
