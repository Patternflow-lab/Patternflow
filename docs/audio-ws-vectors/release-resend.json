{
  "contract": "docs/audio-ws-spec.md#holding-a-value--the-500-ms-release",
  "says": "So a client that means to keep driving **resends its last message at least every 250 ms**, changed or not.",
  "features": ["audio"],
  "steps": [
    { "send": { "ws": "a=0.5,-,-,-" } },
    { "send": { "wait": 250 } },
    { "send": { "ws": "a=0.5,-,-,-" } },
    { "send": { "wait": 250 } },
    { "send": { "ws": "a=0.5,-,-,-" } },
    { "send": { "wait": 250 }, "expect": { "status": { "laneActive": [true, false, false, false] } } },
    { "send": { "wait": 300 }, "expect": { "status": { "laneActive": [false, false, false, false] } } }
  ]
}
