{
  "contract": "docs/osc-spec.md#host--device",
  "says": "Switch to the pattern at this registry index",
  "features": ["osc"],
  "steps": [
    { "send": { "osc": ["/patternflow/pattern/index", 3] } },
    { "send": { "wait": 50 } },
    { "send": { "http": "GET /api/patterns" }, "expect": { "reply": { "body": { "active": 3 } } } },
    { "send": { "osc": ["/patternflow/pattern/index", 0] } },
    { "send": { "wait": 50 } },
    { "send": { "http": "GET /api/patterns" }, "expect": { "reply": { "body": { "active": 0 } } } }
  ]
}
