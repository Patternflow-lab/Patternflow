{
  "contract": "docs/midi-spec.md#settings",
  "says": "Empty string clears it.",
  "features": ["midi"],
  "steps": [
    { "send": { "http": "POST /api/midi?host=192.168.0.23" }, "expect": { "reply": { "status": 200 } } },
    { "send": { "http": "GET /api/midi" }, "expect": { "reply": { "body": { "host": "192.168.0.23" } }, "status": { "midi": { "host": "192.168.0.23" } } } },
    { "send": { "http": { "request": "POST /api/midi", "form": "host=" } }, "expect": { "reply": { "status": 200 } } },
    { "send": { "http": "GET /api/midi" }, "expect": { "reply": { "body": { "host": "" } } } }
  ]
}
