    { "send": { "wait": 3000 } },
    { "send": { "http": "GET /api/patterns/select?index=1" } },
    { "send": { "wait": 20 }, "expect": { "status": { "activeIsModule": true } } },
    { "send": { "http": "GET /api/patterns/file?slug=origin&ext=thumb" }, "expect": { "reply": { "status": 200 } } }
  ]
