{
  "contract": "docs/rest-api.md#get-apipatternsfile",
  "says": "`404` until the pattern has been played once; presets (`origin`) get one the same way.",
  "features": [],
  "steps": [
    { "send": { "http": "GET /api/patterns/select?index=0" } },
    { "send": { "wait": 20 } },
