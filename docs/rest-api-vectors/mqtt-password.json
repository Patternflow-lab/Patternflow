{
  "contract": "docs/rest-api.md#get-apimqtt",
  "says": "Passwords are never returned — only whether one is set.",
  "features": ["mqtt"],
  "steps": [
    { "send": { "http": "GET /api/mqtt" }, "expect": { "reply": { "body": { "hasPassword": false, "normalHasPassword": false } } } },
    {
      "send": { "http": { "request": "POST /api/mqtt", "form": "host=broker.lan&user=ha&password=hunter2" } },
      "expect": { "reply": { "status": 200, "body": { "host": "broker.lan", "user": "ha", "hasPassword": true, "normalHasPassword": true, "password": "<absent>", "pass": "<absent>" } } }
    },
    {
      "send": { "http": "GET /api/mqtt" },
      "expect": { "reply": { "body": { "host": "broker.lan", "user": "ha", "hasPassword": true, "normalHasPassword": true, "password": "<absent>", "pass": "<absent>" } } }
    }
  ]
}
