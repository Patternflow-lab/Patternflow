{
  "contract": "docs/mqtt-spec.md#transport",
  "says": "Channels 1–4 force the Subscriber role.",
  "features": ["mqtt"],
  "steps": [
    { "send": { "http": "POST /api/mqtt?prefix=patternflow5&role=publisher" } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttRole": "publisher", "mqttConnected": true } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow1&role=publisher" } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttRole": "subscriber", "mqttConnected": true } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow2&role=publisher" } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttRole": "subscriber", "mqttConnected": true } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow3&role=publisher" } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttRole": "subscriber", "mqttConnected": true } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow4&role=publisher" } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttRole": "subscriber", "mqttConnected": true } } },
    { "send": { "mqtt": { "topic": "patternflow4/pattern", "payload": "Wave Saw" } } },
    { "send": { "wait": 20 }, "expect": { "status": { "active": "Wave Saw" } } }
  ]
}
