{
  "contract": "docs/mqtt-spec.md#which-topic-to-write",
  "says": "The panel diffs it against the last value it received and injects the difference as a detent delta.",
  "features": ["mqtt"],
  "steps": [
    { "send": { "http": "POST /api/mqtt?role=subscriber" } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttConnected": true } } },
    { "send": { "mqtt": { "topic": "patternflow/knob/2", "payload": "0" } } },
    { "send": { "wait": 20 }, "expect": { "input": { "given": { "deltas": [0, 0, 0, 0] } } } },
    { "send": { "mqtt": { "topic": "patternflow/knob/2", "payload": "5" } } },
    { "send": { "wait": 20 }, "expect": { "input": { "given": { "deltas": [0, 5, 0, 0] } } } },
    { "send": { "mqtt": { "topic": "patternflow/knob/2", "payload": "5" } } },
    { "send": { "wait": 20 }, "expect": { "input": { "given": { "deltas": [0, 5, 0, 0] } } } },
    { "send": { "mqtt": { "topic": "patternflow/knob/2", "payload": "-2" } } },
    { "send": { "wait": 20 }, "expect": { "input": { "given": { "deltas": [0, -2, 0, 0] } } } },
    { "send": { "mqtt": { "topic": "patternflow/knob/2", "payload": "25" } } },
    { "send": { "wait": 20 }, "expect": { "input": { "given": { "deltas": [0, 25, 0, 0] } } } }
  ]
}
