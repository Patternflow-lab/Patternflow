{
  "contract": "docs/mqtt-spec.md#transport",
  "says": "Prefix `patternflow` is **Broadcast**; `patternflow1` … `patternflow4` are **channels 1–4**; `patternflow5` is **Live**; anything else is **Custom**.",
  "features": ["mqtt"],
  "steps": [
    { "send": { "http": "POST /api/mqtt?prefix=patternflow3&role=subscriber" }, "expect": { "reply": { "body": { "channel": "ch3", "prefix": "patternflow3" } } } },
    { "send": { "wait": 20 }, "expect": { "status": { "mqttConnected": true } } },
    { "send": { "mqtt": { "topic": "patternflow/param/1", "payload": "900" } } },
    { "send": { "wait": 20 }, "expect": { "status": { "paramActive": [false, false, false, false] } } },
    { "send": { "mqtt": { "topic": "patternflow3/param/1", "payload": "900" } } },
    { "send": { "wait": 20 }, "expect": { "status": { "params": [900, "<integer>", "<integer>", "<integer>"], "paramActive": [true, false, false, false] } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow" }, "expect": { "reply": { "body": { "channel": "broadcast" } } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow1" }, "expect": { "reply": { "body": { "channel": "ch1" } } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow2" }, "expect": { "reply": { "body": { "channel": "ch2" } } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow4" }, "expect": { "reply": { "body": { "channel": "ch4" } } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow5" }, "expect": { "reply": { "body": { "channel": "live" } } } },
    { "send": { "http": "POST /api/mqtt?prefix=patternflow6" }, "expect": { "reply": { "body": { "channel": "custom" } } } },
    { "send": { "http": "POST /api/mqtt?prefix=studio" }, "expect": { "reply": { "body": { "channel": "custom" } } } }
  ]
}
